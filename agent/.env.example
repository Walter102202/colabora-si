# Reference agent settings. Copy to agent/.env (never commit the copy).

# Model slot: any OpenAI-compatible chat completions endpoint with tool calling.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=your-model-id
# Optional; omit for providers that do not accept reasoning_effort. Managed Trama defaults to low for an ordinary task step.
MODEL_REASONING_EFFORT=
# Effort of a planning turn (the first one, and after an error, a conflict, a person's answer or a changed brief) and of the chat
# with a person. Leave both empty: with MODEL_REASONING_EFFORT set they default to medium and minimal; without it every turn omits
# the field, which a provider that rejects reasoning_effort needs.
MODEL_EFFORT_PLAN=
MODEL_EFFORT_CHAT=
# 1 when the model reads this file type. Not verified on 2026-10-30: no local model credentials were configured.
WORKSPACE_MODEL_VISION=0
WORKSPACE_MODEL_PDF=0
# Colabora (platform agent): MODEL_NAME=muse-wonder-1.0 with MODEL_REASONING_EFFORT=low MODEL_PRICE_IN=4 MODEL_PRICE_OUT=20; see README "Run as the workspace's Colabora agent".
# Prices in USD per million tokens, used to report measured cost (0 = unknown).
MODEL_PRICE_IN=0
MODEL_PRICE_OUT=0

# Workspace: remote MCP URL and this agent's personal access token (Settings > Agents).
WORKSPACE_MCP_URL=https://<project-ref>.supabase.co/functions/v1/mcp
# Optional: the workspace endpoint (create pages, databases, views). Its tools join the catalog; managed Trama derives it.
WORKSPACE_TOOLS_MCP_URL=
WORKSPACE_AGENT_PAT=agt_...
# Optional; defaults to <MCP origin>/functions/v1/agent-token.
WORKSPACE_AGENT_TOKEN_URL=

# Name reported on each claimed run.
AGENT_HARNESS_NAME=reference-agent
# Model turns per run before the agent gives up.
AGENT_MAX_TURNS=40
AGENT_MAX_WORK_RUNS=1
AGENT_MAX_REQUEST_RUNS=3
AGENT_CONTEXT_BUDGET_TOKENS=100000
# Lead only: agent id of the reviewer instance.
AGENT_REVIEWER_AGENT_ID=

# Public URL of the web app, for deep links in notifications: <WORKSPACE_APP_URL>/p/<row page>?task=<task id>.
WORKSPACE_APP_URL=

# Optional Telegram channel. Leave the token empty to print to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Platform agent only: what the owner writes or says on Telegram reaches the workspace. Voice notes need ffmpeg.
AGENT_INBOX=0
# IANA zone for the dates of notes, such as America/Santiago.
AGENT_TIMEZONE=
# FFMPEG_PATH=ffmpeg

# Optional public identity; AGENT_HARNESS_NAME still identifies the runtime in records.
AGENT_DISPLAY_NAME=

# polling is message-only. webhook receives the verified server queue and enables AGENT_INBOX.
TELEGRAM_TRANSPORT=polling
# Keep TELEGRAM_WEBHOOK_SECRET only in Supabase / the separate registration process, never here.
