# Reference agent settings. Copy to agent/.env (never commit the copy).

# Model slot: any OpenAI-compatible chat completions endpoint with tool calling.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=your-model-id
# Prices in USD per million tokens, used to report measured cost (0 = unknown).
MODEL_PRICE_IN=0
MODEL_PRICE_OUT=0

# Workspace: remote MCP URL and this agent's personal access token (Settings > Agents).
WORKSPACE_MCP_URL=https://<project-ref>.supabase.co/functions/v1/mcp
WORKSPACE_AGENT_PAT=agt_...
# Optional; defaults to <MCP origin>/functions/v1/agent-token.
WORKSPACE_AGENT_TOKEN_URL=

# Name reported on each claimed run.
AGENT_HARNESS_NAME=reference-agent
# Model turns per run before the agent gives up.
AGENT_MAX_TURNS=40

# Deep links in notifications: <NEXT_PUBLIC_APP_URL>/p/<row page>?task=<task id>.
NEXT_PUBLIC_APP_URL=

# Optional Telegram channel. Leave the token empty to print to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
