# Secrets for the Edge Functions (supabase functions serve --env-file ... / supabase secrets set ...).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime; do not set them here.

# Derives each agent's login password: hmac_sha256(AGENT_LOGIN_PEPPER, auth_user_id). Long random value.
AGENT_LOGIN_PEPPER=
# Local development only: the seed (supabase/seeds/02_agents.sql) derives the demo agents' logins from this pepper
# and plants demo agent tokens that only work with it. Never use these values on a hosted project.
#   AGENT_LOGIN_PEPPER=local-dev-login-pepper
#   Lead token:  agt_LOCALDEVLEAD0000000000000000000000000001
#   Codex token: agt_LOCALDEVCODEX000000000000000000000000002
#   Colabora token: agt_LOCALDEVCOLABORA000000000000000000000003
#   Reviewer token: agt_LOCALDEVREVIEWER000000000000000000000004
# Local development only: the runtime's SUPABASE_URL is http://kong:8000, so the mcp function rejects local tokens
# (issuer http://127.0.0.1:54321/auth/v1) unless MCP_AUTH_SERVER_URL names that issuer.
#   MCP_AUTH_SERVER_URL=http://127.0.0.1:54321/auth/v1
# Comma-separated browser origins allowed to call the mcp function.
MCP_ALLOWED_ORIGINS=
# Public URL of the mcp function, e.g. https://<ref>.supabase.co/functions/v1/mcp
MCP_RESOURCE_URL=
# Supabase Auth issuer, e.g. https://<ref>.supabase.co/auth/v1
MCP_AUTH_SERVER_URL=
# Public URL of the web app, used for page links in tool results, e.g. https://app.example.com
APP_URL=
# Shared secret of the dispatch tick: the same value as the Vault secret dispatch_cron_secret.
DISPATCH_SECRET=

# Voice transcription. Only voice-transcribe reads these; the key never reaches a browser or an agent host.
META_MODEL_API_KEY=
# META_API_BASE=https://api.meta.ai
# Comma-separated language names and words the transcription should expect. Empty detects the language.
VOICE_LANGUAGE_BIAS=
VOICE_KEYWORDS=

# Derives a separate signing secret for each GitHub CI connection. Use a long random value when hosted.
CI_WEBHOOK_PEPPER=local-ci-webhook-pepper

# Telegram server transport. Keep its webhook secret out of the agent runtime environment.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_BASE=https://api.telegram.org
# Configure private.app_secrets telegram_bot_username for connect links.
# Separate OAuth protected resource for direct workspace tools.
MCP_WORKSPACE_RESOURCE_URL=http://127.0.0.1:60990/functions/v1/workspace-mcp

# Optional copy of each waitlist signup to Notion. Without both, the list stays only in the database.
# The database needs a title property called Email and a date property called Joined, connected to the integration.
NOTION_TOKEN=
NOTION_WAITLIST_DATABASE_ID=
