# Secrets for the Edge Functions (supabase functions serve --env-file ... / supabase secrets set ...).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the runtime; do not set them here.

# Derives each agent's login password: hmac_sha256(AGENT_LOGIN_PEPPER, auth_user_id). Long random value.
AGENT_LOGIN_PEPPER=
# Comma-separated browser origins allowed to call the mcp function.
MCP_ALLOWED_ORIGINS=
# Public URL of the mcp function, e.g. https://<ref>.supabase.co/functions/v1/mcp
MCP_RESOURCE_URL=
# Supabase Auth issuer, e.g. https://<ref>.supabase.co/auth/v1
MCP_AUTH_SERVER_URL=
# Public URL of the web app, used for page links in tool results, e.g. https://app.example.com
APP_URL=
# Shared secret of the dispatch tick: the same value as the Vault secret dispatch_cron_secret.
DISPATCH_SECRET=
