[
  { "name": "plain text with a digit", "md": "I have 2 cats", "blocks": [{ "type": "paragraph", "spans": ["I have 2 cats"] }] },
  { "name": "inline code", "md": "`a 2 b`", "blocks": [{ "type": "paragraph", "spans": [{ "text": "a 2 b", "code": true }] }] },
  { "name": "unsafe link scheme", "md": "[x](javascript:alert(1))", "blocks": [{ "type": "paragraph", "spans": ["x"] }] },
  { "name": "unsafe link scheme with control characters", "md": "[y](JAVA\tSCRIPT:alert(1))", "blocks": [{ "type": "paragraph", "spans": ["[y](JAVA\tSCRIPT:alert(1))"] }] },
  { "name": "data link", "md": "see [z](data:text/html,hi)", "blocks": [{ "type": "paragraph", "spans": ["see z"] }] },
  { "name": "safe links", "md": "[site](https://a.test) and [mail](mailto:a@b.test)", "blocks": [{ "type": "paragraph", "spans": [{ "text": "site", "href": "https://a.test" }, " and ", { "text": "mail", "href": "mailto:a@b.test" }] }] },
  { "name": "inline marks", "md": "**bold** *it* ~~gone~~ `code`", "blocks": [{ "type": "paragraph", "spans": [{ "text": "bold", "bold": true }, " ", { "text": "it", "italic": true }, " ", { "text": "gone", "strike": true }, " ", { "text": "code", "code": true }] }] },
  { "name": "nested marks", "md": "**bold *and italic***", "blocks": [{ "type": "paragraph", "spans": [{ "text": "bold ", "bold": true }, { "text": "and italic", "bold": true, "italic": true }] }] },
  { "name": "marks are not triggered by arithmetic or snake case", "md": "2 * 3 * 4 and snake_case_name", "blocks": [{ "type": "paragraph", "spans": ["2 * 3 * 4 and snake_case_name"] }] },
  { "name": "html is plain text", "md": "<b>x</b> & <script>", "blocks": [{ "type": "paragraph", "spans": ["<b>x</b> & <script>"] }] },
  { "name": "headings", "md": "# One\n## Two\n### Three\n#### Four", "blocks": [{ "type": "heading1", "spans": ["One"] }, { "type": "heading2", "spans": ["Two"] }, { "type": "heading3", "spans": ["Three"] }, { "type": "heading3", "spans": ["Four"] }] },
  { "name": "nested list", "md": "- a\n  - b\n    - c\n1. one\n  2. two", "blocks": [{ "type": "bulleted", "spans": ["a"] }, { "type": "bulleted", "spans": ["b"], "indent": 1 }, { "type": "bulleted", "spans": ["c"], "indent": 2 }, { "type": "numbered", "spans": ["one"] }, { "type": "numbered", "spans": ["two"], "indent": 1 }] },
  { "name": "todo", "md": "- [ ] open\n* [x] done", "blocks": [{ "type": "todo", "spans": ["open"], "checked": false }, { "type": "todo", "spans": ["done"], "checked": true }] },
  { "name": "toggle", "md": "▸ Details", "blocks": [{ "type": "toggle", "spans": ["Details"] }] },
  { "name": "quote", "md": "> quoted\n>tight", "blocks": [{ "type": "quote", "spans": ["quoted"] }, { "type": "quote", "spans": ["tight"] }] },
  { "name": "callout", "md": "> 💡 Remember **this**", "blocks": [{ "type": "callout", "icon": "💡", "spans": ["Remember ", { "text": "this", "bold": true }] }] },
  { "name": "code with language", "md": "```ts\nconst a = 1;\n# not a heading\n```", "blocks": [{ "type": "code", "spans": ["const a = 1;\n# not a heading"], "language": "ts" }] },
  { "name": "code without language", "md": "```\nx\n```", "blocks": [{ "type": "code", "spans": ["x"], "language": "plaintext" }] },
  { "name": "divider", "md": "---\n***", "blocks": [{ "type": "divider" }, { "type": "divider" }] },
  { "name": "equation on one line", "md": "$$E = mc^2$$", "blocks": [{ "type": "equation", "equation": "E = mc^2" }] },
  { "name": "equation block", "md": "$$\na^2 + b^2\n$$", "blocks": [{ "type": "equation", "equation": "a^2 + b^2" }] },
  { "name": "image", "md": "![A cat](https://img.test/cat.png)\n![bad](javascript:x)", "blocks": [{ "type": "image", "url": "https://img.test/cat.png", "caption": "A cat" }, { "type": "paragraph", "spans": ["bad"] }] },
  { "name": "escaped markers", "md": "\\*not italic\\*", "blocks": [{ "type": "paragraph", "spans": ["*not italic*"] }] },
  { "name": "link with parentheses in the url", "md": "[f](https://a.test/f(1))", "blocks": [{ "type": "paragraph", "spans": [{ "text": "f", "href": "https://a.test/f(1)" }] }] },
  { "name": "empty input", "md": "\n\n", "blocks": [] }
]
