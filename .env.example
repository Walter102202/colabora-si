# Supabase (optional). Without these two the app is 100 % local-first.
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy name VITE_SUPABASE_ANON_KEY is accepted as an alias.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Web Push (optional). VAPID public key, base64url.
VITE_VAPID_PUBLIC_KEY=
# Public URL of this app (used in links sent to people and agents).
VITE_APP_URL=
# 1 on the deployment that runs the managed Trama (agent/fleet.mjs): Trama arrives by itself and nobody enables it.
VITE_TRAMA_MANAGED=
# Remote MCP endpoint shown in the connection snippets (Supabase Edge Function `mcp`).
VITE_MCP_URL=
