# Supabase (optional). Without these two the app is 100 % local-first.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web Push (optional). VAPID public key, base64url.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Public URL of this app (used in links sent to people and agents).
NEXT_PUBLIC_APP_URL=
# Remote MCP endpoint shown in the connection snippets (Supabase Edge Function `mcp`).
NEXT_PUBLIC_MCP_URL=
